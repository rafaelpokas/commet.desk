# Piloto local (não expor na internet; autenticação por perfis de demonstração).
NODE_ENV=development
PORT=3000
# Em migrações, use um diretório separado para preservar a base anterior.
DATA_DIR=./data
# Bucket privado no disco do servidor. Não é uma pasta pública nem um bucket cloud.
BRAND_STORAGE_DIR=./data/brand-assets

# Public deployment is blocked until real identity is configured.
COMMET_DEMO_MODE=0
COMMET_AUTO_SYNC=0
# Absolute private JSON manifest. Never put this under public/ or dist/.
COMMET_CATALOG_FILE=
COMMET_ASSET_DIR=
# Backend credentials only; never use VITE_ for these values.
GITHUB_TOKEN=
COMMET_GITHUB_REPOSITORY=rafaelpokas/commet-brain
GOOGLE_APPLICATION_CREDENTIALS=
# Or delegated OAuth credentials for the Drive account:
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Map client IDs to explicit folders per administrative/internal/shared access.
COMMET_DRIVE_FOLDERS_JSON={}
